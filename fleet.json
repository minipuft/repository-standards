{
  "schemaVersion": 1,
  "upstream": {
    "repository": "minipuft/claude-prompts",
    "packagePath": "server/package.json",
    "releaseWorkflowPath": ".github/workflows/extension-publish.yml"
  },
  "repositories": [
    {
      "repository": "minipuft/gemini-prompts",
