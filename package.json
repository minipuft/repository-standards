{
  "name": "@minipuft/repository-standards-validation",
  "version": "1.9.0",
  "private": true,
  "type": "module",
  "bin": {
    "retire-done-plans": "bin/retire-done-plans.cjs",
    "delivery-contract": "bin/delivery-contract.cjs"
  },
  "exports": {
    "./eslint": "./eslint/index.mjs",
    "./eslint/typed": "./eslint/typed.mjs",
    "./*": "./*"
  },
  "files": [
    "bin/delivery-contract.cjs",
    "bin/retire-done-plans.cjs",
    "contracts/delivery-contract.schema.json",
    "contracts/plan-retirement.schema.json",
    "conventions/plan-frontmatter.md",
    "eslint/",
    "templates/"
  ],
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0",
    "eslint-plugin-sonarjs": "^4.0.0",
    "typescript-eslint": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    },
    "eslint-plugin-sonarjs": {
      "optional": true
    },
    "typescript-eslint": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\"",
    "audit:fleet": "node scripts/audit-fleet.mjs",
    "validate:workflows": "node scripts/validate-workflows.mjs",
    "validate:renovate": "renovate-config-validator --strict renovate/default.json renovate/downstream.json",
    "format:check": "prettier --check .",
    "validate": "npm test && npm run validate:workflows && npm run validate:renovate && npm run format:check"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "eslint": "10.12.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "prettier": "3.6.2",
    "renovate": "44.7.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "yaml": "2.9.0"
  }
}
