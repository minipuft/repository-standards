{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/minipuft/repository-standards/contracts/fleet.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "upstream", "repositories"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "repositoryId",
        "packagePath",
        "releaseWorkflowPath"
      ],
      "properties": {
        "repository": { "$ref": "#/definitions/repository" },
        "repositoryId": { "$ref": "#/definitions/repositoryId" },
        "packagePath": { "type": "string", "minLength": 1 },
        "releaseWorkflowPath": { "type": "string", "minLength": 1 }
      }
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "repositoryId"],
        "properties": {
          "repository": { "$ref": "#/definitions/repository" },
          "repositoryId": { "$ref": "#/definitions/repositoryId" },
          "profile": {
            "enum": ["marketplace", "node-consumer", "npm-publisher"]
          },
          "standardsRef": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "requiredChecks": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "nodeMajor": { "type": ["string", "null"], "pattern": "^\\d+$" },
          "claudePromptsWriter": { "const": "claude-prompts-release-sync" },
          "mergeMode": { "const": "auto" },
          "renovatePresetVersion": {
            "type": ["string", "null"],
            "pattern": "^v\\d+\\.\\d+\\.\\d+$"
          },
          "dependencyAutomation": { "enum": ["none", "migrating", "renovate"] },
          "deliveryContract": {
            "type": "boolean",
            "description": "whether the repo is expected to carry `.delivery-contract.json`"
          },
          "consumerContract": {
            "type": "boolean",
            "description": "whether the repo is expected to carry `downstream-contract.json` and be audited as a claude-prompts consumer (profile, standardsRef, requiredChecks, nodeMajor, claudePromptsWriter, mergeMode, renovatePresetVersion, dependencyAutomation). Defaults to true — omit only when the repo genuinely has no consumer contract, e.g. it is audited solely for the delivery contract."
          }
        },
        "if": {
          "properties": { "consumerContract": { "const": false } },
          "required": ["consumerContract"]
        },
        "then": {},
        "else": {
          "required": [
            "profile",
            "standardsRef",
            "requiredChecks",
            "nodeMajor",
            "claudePromptsWriter",
            "mergeMode",
            "renovatePresetVersion",
            "dependencyAutomation"
          ]
        }
      }
    }
  },
  "definitions": {
    "repository": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
    "repositoryId": { "type": "integer", "exclusiveMinimum": 0 }
  }
}
